{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "id": "${TEAMS_APP_ID}",
  "version": "1.2.0",
  "packageName": "com.enterprise.maude.analytics",
  "developer": {
    "name": "Data Services and Solutions",
    "websiteUrl": "${PUBLIC_APP_URL}",
    "privacyUrl": "${PUBLIC_APP_URL}/docs",
    "termsOfUseUrl": "${PUBLIC_APP_URL}/docs"
  },
  "name": {
    "short": "Insights Chat",
    "full": "Insights Chat"
  },
  "description": {
    "short": "Experimental demo of in-Teams chat interface for Zoo reporting data.",
    "full": "Experimental demo of in-Teams chat interface for Zoo reporting data."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#005589",
  "defaultInstallScope": "personal",
  "staticTabs": [
    {
      "entityId": "maudeDiveViewerTab",
      "name": "Data Explorer Workspace",
      "contentUrl": "${PUBLIC_APP_URL}/tab/explorer",
      "websiteUrl": "${PUBLIC_APP_URL}/tab/explorer",
      "scopes": [
        "personal"
      ]
    }
  ],
  "bots": [
    {
      "botId": "${TEAMS_BOT_ID}",
      "scopes": [
        "personal",
        "team"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": [
    "identity"
  ],
  "validDomains": [
    "${APP_DOMAIN}"
  ],
  "webApplicationInfo": {
    "id": "${TEAMS_TAB_AAD_APP_ID}",
    "resource": "${TEAMS_API_APPLICATION_ID_URI}"
  }
}
